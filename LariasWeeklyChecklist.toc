# CallbackHandler: event/callback backbone required by AceEvent, AceBucket, etc.
Libs\\CallbackHandler-1.0\\CallbackHandler-1.0.lua

# Ace3 core
# AceAddon: addon lifecycle (OnInitialize / OnEnable / OnDisable)
Libs\\Ace3\\AceAddon-3.0\\AceAddon-3.0.lua

# AceEvent: WoW event registration / unregistration helpers
Libs\\Ace3\\AceEvent-3.0\\AceEvent-3.0.lua

# AceDB: saved-variables management with profile support
Libs\\Ace3\\AceDB-3.0\\AceDB-3.0.lua

# AceConsole: slash-command registration and print helpers
Libs\\Ace3\\AceConsole-3.0\\AceConsole-3.0.lua

# AceTimer: reliable once/repeating timer scheduling
Libs\\Ace3\\AceTimer-3.0\\AceTimer-3.0.lua

# Cross-realm communication
# AceSerializer: table → string serialization for addon messages
Libs\\Ace3\\AceSerializer-3.0\\AceSerializer-3.0.lua

# ChatThrottleLib: rate-limits outgoing addon channel traffic (AceComm dep)
Libs\\Ace3\\AceComm-3.0\\ChatThrottleLib.lua

# AceComm: send/receive structured addon messages over addon channels
Libs\\Ace3\\AceComm-3.0\\AceComm-3.0.lua

# AceBucket: batches rapid-fire events into a single throttled callback
Libs\\Ace3\\AceBucket-3.0\\AceBucket-3.0.lua

